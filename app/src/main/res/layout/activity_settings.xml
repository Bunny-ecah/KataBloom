<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6FB">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:background="@drawable/bg_gradient"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:text="Settings"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/tvHeaderSubtitle"
            android:text="Personalize your experience"
            android:textSize="14sp"
            android:textColor="#EAF0FF"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- PARENT PROFILE -->
            <LinearLayout
                android:id="@+id/cardParentProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:orientation="vertical"
                android:elevation="4dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvParentName"
                    android:text="Parent Name"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/tvParentEmail"
                    android:text="Email"
                    android:textSize="14sp"
                    android:textColor="#666"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"/>

                <Button
                    android:id="@+id/btnEditParent"
                    android:text="Edit Profile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- ACTIVE CHILD -->
            <LinearLayout
                android:id="@+id/cardActiveChild"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:orientation="vertical"
                android:elevation="4dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvActiveChildName"
                    android:text="Active Child Name"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/tvActiveChildAge"
                    android:text="Active Child Age"
                    android:textSize="14sp"
                    android:textColor="#666"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <Button
                    android:id="@+id/btnChangeChild"
                    android:text="Switch Child"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>

            <!-- CHILD MANAGEMENT -->
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvChildren"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="10dp"/>
                <Button
                    android:id="@+id/btnAddChild"
                    android:text="Add Child"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"/>

                <Button
                    android:id="@+id/btnEditProfile"
                    android:text="Edit Child Profile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"/>

                <Button
                    android:id="@+id/btnDeleteChild"
                    android:text="Delete Child"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <!-- LOGOUT BUTTON -->
                <Button
                    android:id="@+id/btnLogout"
                    android:text="Logout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:backgroundTint="#F45DA2"
                    android:textColor="@android:color/white"
                    android:textAllCaps="false"/>
            </LinearLayout>



        </LinearLayout>
    </ScrollView>

    <!-- BOTTOM NAV -->
    <include layout="@layout/bottom_nav"/>
</LinearLayout>