<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#F4F6FB"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="22dp"
        android:background="@drawable/bg_gradient">

        <!-- BACK BUTTON -->
        <TextView
            android:id="@+id/btnBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="←"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_circle_white_transparent"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:id="@+id/tvQuizTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Quiz Challenge"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/tvLevelInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Level 1"
                android:textSize="15sp"
                android:textColor="#EAF0FF"
                android:layout_marginTop="6dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- QUESTION CARD -->
            <LinearLayout
                android:id="@+id/cardQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:padding="20dp"
                android:orientation="vertical"
                android:elevation="6dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tvQuestionNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Question 1"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#4B63F1" />

                <TextView
                    android:id="@+id/tvQuestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="What is the first letter of Apple?"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#222222"
                    android:layout_marginTop="12dp" />

            </LinearLayout>

            <!-- OPTIONS CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:elevation="5dp"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btnOptionA"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:text="A"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#222222"
                    android:backgroundTint="#EEF1FF"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btnOptionB"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:text="B"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#222222"
                    android:backgroundTint="#EEF1FF"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btnOptionC"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:text="C"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#222222"
                    android:backgroundTint="#EEF1FF"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btnOptionD"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:text="D"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#222222"
                    android:backgroundTint="#EEF1FF" />

            </LinearLayout>

            <!-- FEEDBACK CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:elevation="4dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tvFeedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Choose the correct answer"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#4B63F1"
                    android:gravity="center"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/tvProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Progress: 0/0"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#666666"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/tvScore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Score: 0"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#666666"
                    android:gravity="center"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvStars"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Stars: 0"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#666666"
                    android:gravity="center"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <!-- NEXT BUTTON -->
            <Button
                android:id="@+id/btnNext"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Next Question"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#4B63F1"
                android:textColor="#FFFFFF"
                android:elevation="5dp"
                android:layout_marginBottom="16dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>