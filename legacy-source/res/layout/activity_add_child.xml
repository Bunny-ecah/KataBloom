<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_soft">

    <!-- Back Button -->
    <Button
        android:id="@+id/btnBack"
        android:layout_width="50dp"
        android:layout_height="40dp"
        android:text="←"
        android:textSize="18sp"
        android:textStyle="bold"
        android:backgroundTint="#4B63F1"
        android:textColor="@android:color/white"
        android:layout_marginBottom="16dp"/>

    <!-- Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Child Profile"
        android:textSize="28sp"
        android:textColor="@color/dark_text"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter your child's information"
        android:textSize="14sp"
        android:textColor="@color/dark_text"
        android:layout_marginBottom="24dp"/>

    <!-- Child Name Input -->
    <EditText
        android:id="@+id/etChildName"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/edittext_rounded"
        android:hint="Child Name"
        android:padding="16dp"
        android:textColor="@color/dark_text"
        android:textColorHint="#808080"/>

    <!-- Child Age Input -->
    <EditText
        android:id="@+id/etChildAge"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/edittext_rounded"
        android:hint="Child Age"
        android:inputType="number"
        android:padding="16dp"
        android:textColor="@color/dark_text"
        android:textColorHint="#808080"/>

    <!-- Save Button -->
    <Button
        android:id="@+id/btnSaveChild"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="@drawable/button_rounded"
        android:text="Save Child Profile"
        android:textColor="@android:color/white"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:layout_marginBottom="16dp"/>

</LinearLayout>