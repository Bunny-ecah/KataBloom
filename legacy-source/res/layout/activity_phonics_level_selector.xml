<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#F4F6FB"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="22dp"
        android:background="@drawable/bg_gradient">

        <!-- BACK BUTTON -->
        <TextView
            android:id="@+id/btnBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="←"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_circle_white_transparent"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔤 Phonics Level"
                android:textSize="27sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Choose a level to start learning letters and sounds"
                android:textSize="15sp"
                android:textColor="#EAF0FF"
                android:layout_marginTop="6dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- INTRO CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="18dp"
                android:elevation="4dp"
                android:layout_marginBottom="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Start with a suitable level"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="#222222" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Each level helps children practise phonics step by step."
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:layout_marginTop="6dp" />

            </LinearLayout>

            <Button
                android:id="@+id/btnLevel1"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:text="🌱 Level 1  •  Easy"
                android:textAllCaps="false"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#4B63F1"
                android:elevation="5dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Basic letters, simple sounds, and early phonics practice."
                android:textSize="13sp"
                android:textColor="#666666"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnLevel2"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:text="🌼 Level 2  •  Medium"
                android:textAllCaps="false"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#52C7B8"
                android:elevation="5dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Practise more letter sounds and simple word recognition."
                android:textSize="13sp"
                android:textColor="#666666"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnLevel3"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:text="🌟 Level 3  •  Hard"
                android:textAllCaps="false"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#F45D73"
                android:elevation="5dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="More challenging phonics practice for better reading confidence."
                android:textSize="13sp"
                android:textColor="#666666"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="18dp" />

            <!-- TIP CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:elevation="4dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💡 Tip"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#222222" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Start with Level 1 if the child is still learning basic letter sounds."
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:layout_marginTop="6dp" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>