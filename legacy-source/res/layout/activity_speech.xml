<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F6FB">

    <!-- HEADER -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="22dp"
        android:background="@drawable/bg_gradient">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:text="←"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:background="@drawable/bg_circle_white_transparent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎙 Speech Practice"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/tvChildInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Listen and pronounce the word"
                android:textSize="15sp"
                android:textColor="#EAF0FF" />
        </LinearLayout>
    </LinearLayout>

    <!-- CONTENT -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="20dp">
        <!-- MAIN CARD -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:background="@drawable/bg_card"
            android:elevation="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Word to Pronounce"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#222222"
                android:layout_marginBottom="18dp" />
            <!-- WORD -->

            <TextView
                android:id="@+id/tvWord"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:gravity="center"
                android:text="Apple"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="#4B63F1"
                android:background="@drawable/bg_icon_circle" />

            <TextView
                android:id="@+id/tvHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hint: Fruit"
                android:textSize="16sp"
                android:textColor="#666666"
                android:gravity="center"
                android:layout_marginTop="18dp" />

            <TextView
                android:id="@+id/tvFeedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Listen and pronounce the word"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#4B63F1"
                android:gravity="center"
                android:layout_marginTop="15dp" />
            <!-- BUTTON SECTION -->

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="28dp">
                <!-- LISTEN BUTTON -->

                <LinearLayout
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/btnSpeaker"
                        android:layout_width="75dp"
                        android:layout_height="75dp"
                        android:src="@android:drawable/ic_lock_silent_mode_off"
                        android:padding="18dp"
                        android:background="@drawable/bg_speaker_button"
                        android:contentDescription="Listen"
                        app:tint="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Listen"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#4B63F1"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
                <!-- SPEAK BUTTON -->

                <LinearLayout
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginStart="15dp">

                    <ImageView
                        android:id="@+id/btnMic"
                        android:layout_width="75dp"
                        android:layout_height="75dp"
                        android:src="@android:drawable/ic_btn_speak_now"
                        android:padding="18dp"
                        android:background="@drawable/bg_mic_button"
                        android:contentDescription="Speak"
                        app:tint="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Speak"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#34A853"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
                <!-- NEXT BUTTON -->

                <LinearLayout
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginStart="15dp">

                    <ImageView
                        android:id="@+id/btnNext"
                        android:layout_width="75dp"
                        android:layout_height="75dp"
                        android:src="@android:drawable/ic_media_next"
                        android:padding="18dp"
                        android:background="@drawable/bg_next_button"
                        android:contentDescription="Next"
                        app:tint="#FFFFFF" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Next"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#FF9800"
                            android:layout_marginTop="8dp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <!-- PROGRESS + REWARD CARD -->


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📈 Practice Progress"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:layout_marginTop="12dp"/>

                <TextView
                    android:id="@+id/tvProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Progress: 1/10"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginTop="12dp"/>

                <TextView
                    android:id="@+id/tvScore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⭐️ Score: 0"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textColor="#FF9800"
                    android:layout_marginTop="8dp"/>

                <TextView
                    android:id="@+id/tvBadge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🏆 Badge: Start Learning!"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textColor="#9C27B0"
                    android:layout_marginTop="10dp"/>
            </LinearLayout>

    </ScrollView>
</LinearLayout>