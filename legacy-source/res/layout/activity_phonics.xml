<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F6FB">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="22dp"
        android:background="@drawable/bg_gradient">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:text="←"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:background="@drawable/bg_circle_white_transparent"
            android:clickable="true"
            android:focusable="true"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔤 Phonics Learning"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"/>
            <TextView
                android:id="@+id/tvProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Progress: 0/0"
                android:textSize="15sp"
                android:textColor="#EAF0FF"
                android:layout_marginTop="6dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal">

            <!-- PHONICS CARD -->
            <LinearLayout
                android:id="@+id/cardPhonicsDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="24dp"
                android:background="@drawable/bg_card"
                android:elevation="6dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Letter Practice"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#222222"/>
                <!-- BIG LETTER -->
                <TextView
                    android:id="@+id/tvBigLetter"
                    android:layout_width="130dp"
                    android:layout_height="130dp"
                    android:layout_marginTop="18dp"
                    android:gravity="center"
                    android:text="A"
                    android:textSize="75sp"
                    android:textStyle="bold"
                    android:textColor="#4B63F1"
                    android:background="@drawable/bg_icon_circle"/>
                <!-- SMALL LETTER -->
                <TextView
                    android:id="@+id/tvSmallLetter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="a"
                    android:textSize="38sp"
                    android:textStyle="bold"
                    android:textColor="#222222"
                    android:gravity="center"
                    android:layout_marginTop="14dp"/>
                <!-- SOUND -->
                <TextView
                    android:id="@+id/tvSound"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="/æ/"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#666666"
                    android:gravity="center"
                    android:layout_marginTop="8dp"/>
                <!-- WORD -->
                <TextView
                    android:id="@+id/tvWord"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Apple"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#222222"
                    android:gravity="center"
                    android:layout_marginTop="18dp"/>

                <!-- LISTEN BUTTON -->
                <ImageView
                    android:id="@+id/btnSpeaker"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginTop="25dp"
                    android:src="@android:drawable/ic_lock_silent_mode_off"
                    app:tint="#FFFFFF"
                    android:padding="18dp"
                    android:background="@drawable/bg_speaker_button"
                    android:contentDescription="Listen"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Listen"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#4B63F1"
                    android:layout_marginTop="8dp"/>
                <!-- INSTRUCTION -->
                <TextView
                    android:id="@+id/tvInstruction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Listen to the sound and practise reading the word."
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:gravity="center"
                    android:layout_marginTop="18dp"/>
            </LinearLayout>

            <!-- TIP CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:elevation="4dp"
                android:padding="16dp"
                android:layout_marginTop="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💡 Learning Tip"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#222222"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Listen to the sound first, then try saying the word."
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>

            <!-- NEXT BUTTON -->
            <Button
                android:id="@+id/btnNext"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Next Question"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#4B63F1"
                android:elevation="5dp"
                android:layout_marginTop="18dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>