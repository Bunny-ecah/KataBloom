rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    match /users/{uid} {
      allow read, write: if owner(uid);
      match /children/{child} {
        allow read, write: if owner(uid);
        match /{record=**} { allow read, write: if owner(uid); }
      }
      match /dyslearn/state {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.keys().hasOnly(['payload', 'updatedAt'])
          && request.resource.data.payload is string
          && request.resource.data.payload.size() <= 700000
          && request.resource.data.updatedAt == request.time;
      }
    }
    match /phonics_questions/{id} { allow read: if request.auth != null; }
    match /speech_questions/{id} { allow read: if request.auth != null; }
    match /quiz_questions/{id} { allow read: if request.auth != null; }
  }
}
